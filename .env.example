# ============================================================
#  Search Console 연동용 환경변수 (예시 파일)
# ============================================================
#  실제 값은 이 파일에 채우지 마세요. 이 파일은 "어떤 값이 필요한지"
#  보여주는 참고용입니다. 진짜 값은 Vercel 프로젝트 →
#  Settings → Environment Variables 에 등록하세요.
#
#  자세한 발급/등록 방법은 SEARCH_CONSOLE_SETUP.md 를 참고하세요.
# ============================================================

# 서비스 계정 이메일 (Google Cloud → 서비스 계정 → 키 JSON의 client_email)
GSC_CLIENT_EMAIL=

# 서비스 계정 비밀 키 (JSON의 private_key, 줄바꿈 포함 그대로)
GSC_PRIVATE_KEY=

# Search Console에 등록된 속성 주소
# 예: https://example.com/  또는  sc-domain:example.com
GSC_SITE_URL=

# 이 프록시를 보호할 임의의 긴 문자열 (직접 생성). 프론트엔드의
# src/game/searchConsoleProxy.ts 에도 동일한 값을 넣어야 합니다.
GSC_PROXY_TOKEN=

# (선택) 이 프록시를 호출할 수 있는 출처. 비워두면 전체 허용("*")
# 예: https://내아이디.github.io
GSC_ALLOWED_ORIGIN=
